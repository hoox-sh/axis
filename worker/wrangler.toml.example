# AXIS Worker deploy config (API + WS relay). Bindings map to Env in src/index.ts.
# Docs-only notes: do not invent production IDs — use values from this file / CF dashboard.
#
# Setup:
#   cp wrangler.toml.example wrangler.toml
#   # edit bindings, vars, and OAuth client ids as needed
#   wrangler deploy
#
# wrangler.toml is gitignored so local secrets / client ids stay out of the repo.

name = "worker-axis"
compatibility_date = "2024-11-01"
compatibility_flags = ["nodejs_compat"]
main = "src/index.ts"

# Canonical production host (optional). workers.dev is worker-axis.<account>.workers.dev.
# [[routes]]
# pattern = "worker.axis.hoox.sh"
# custom_domain = true

# Static PWA assets are hosted by Cloudflare Pages — this Worker is the
# JSON API and the WebSocket relay. Pages serves the frontend/ directory
# via the Pages build pipeline; this wrangler.toml only deploys the Worker.

[observability]
enabled = true

# KV namespaces — create + bind with:
#   axis setup kv
# (or: wrangler kv namespace create API_KEYS, then paste id).
# Required in prod when D1 is bound: otherwise /api/scripts returns 503
# API_KEYS_REQUIRED. Local wrangler dev provisions a local KV automatically
# once the binding is present.
# [[kv_namespaces]]
# binding = "API_KEYS"
# id = "REPLACE_WITH_KV_ID"

# [[kv_namespaces]]
# binding = "USAGE"
# id = "REPLACE_WITH_KV_ID"

# Tenant verify cache (optional; worker runs without it via in-isolate L1).
# Create with `wrangler kv namespace create TENANT_KEYS`, then paste id.
# [[kv_namespaces]]
# binding = "TENANT_KEYS"
# id = "REPLACE_WITH_KV_ID"

# D1 database — created via `wrangler d1 create pynescript`.
# Schema (scripts + versions): axis setup d1 --local|--remote
#   (or wrangler d1 execute pynescript --remote --file=schemas/scripts.sql)
# Binding name MUST be "DB" (code uses env.DB) — not the database name.
[[d1_databases]]
binding = "DB"
database_name = "pynescript"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# R2 bucket — created via `wrangler r2 bucket create indicator-bundles`.
# [[r2_buckets]]
# binding = "BUNDLES"
# bucket_name = "indicator-bundles"

# Durable Objects — the WebSocket session relay.
# [[durable_objects.bindings]]
# name = "SESSIONS"
# class_name = "SessionDO"

# MCP ↔ PWA control plane (required for app_* MCP tools).
[[durable_objects.bindings]]
name = "MCP_BRIDGE"
class_name = "McpBridgeDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["McpBridgeDO"]
# Later SessionDO enablement needs a new tag — never edit v1.
# [[migrations]]
# tag = "v2"
# new_sqlite_classes = ["SessionDO"]

[vars]
# Default external backend if the Worker doesn't run the Python itself.
# When unset, /api/run returns 503 with a hint to set EXTERNAL_BACKEND or
# install the full Python wheel inside the Worker (see worker/RUNTIME.md).
EXTERNAL_BACKEND = ""
ALLOWED_ORIGIN = "https://pynescript.online"
# Do not set ADMIN_TOKEN here. An empty [vars] stub is still a binding, and
# Cloudflare error 10053 rejects `wrangler secret put ADMIN_TOKEN`.
#   axis secret put ADMIN_TOKEN
# ADMIN_TOKEN = ""
PYODIDE_IN_WORKER = "disabled"
# Tenant commerce: verified usage flushes lossy to {CONSOLE_URL}/api/v1/usage
# (2s budget); verify reads GET {CONSOLE_URL}/api/v1/verify with the key hash.
CONSOLE_URL = "https://console.hoox.sh"
# Open keys accept any non-empty Bearer. Off by default ("" = fail closed).
# Local demos without KV only: set ALLOW_OPEN_KEYS = "1" in your local
# wrangler.toml, never in a deployed one.
# PROD WARNING: ALLOW_OPEN_KEYS="1" with D1 bound lets any Bearer partition the
# script library; the console VERIFY_UNAVAILABLE path degrades to allow
# (X-Hoox-Verify: degraded) instead of failing closed 503. Production must keep
# ALLOW_OPEN_KEYS = "" and bind API_KEYS + TENANT_KEYS.
# `axis setup --prod` writes this empty; `axis deploy` refuses open keys + D1
# without API_KEYS KV.
ALLOW_OPEN_KEYS = ""
# Optional: OAuth App client ids for Connect with GitHub / GitLab (device flow).
# Create an OAuth App, enable Device Flow (GitHub), leave secret unused.
# Prefer: wrangler secret put GITHUB_OAUTH_CLIENT_ID
# GITHUB_OAUTH_CLIENT_ID = ""
# GITLAB_OAUTH_CLIENT_ID = ""

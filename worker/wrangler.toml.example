# AXIS Worker deploy config (API + WS relay). Bindings map to Env in src/index.ts.
# Docs-only notes: do not invent production IDs — use values from this file / CF dashboard.
#
# Setup:
#   cp wrangler.toml.example wrangler.toml
#   # edit bindings, vars, and OAuth client ids as needed
#   wrangler deploy
#
# wrangler.toml is gitignored so local secrets / client ids stay out of the repo.

name = "pynescript-axis"
compatibility_date = "2024-11-01"
compatibility_flags = ["nodejs_compat"]
main = "src/index.ts"

# Static PWA assets are hosted by Cloudflare Pages — this Worker is the
# JSON API and the WebSocket relay. Pages serves the frontend/ directory
# via the Pages build pipeline; this wrangler.toml only deploys the Worker.

[observability]
enabled = true

# KV namespaces — create + bind with:
#   axis setup kv
# (or: wrangler kv namespace create API_KEYS, then paste id).
# Required in prod when D1 is bound: otherwise /api/scripts returns 503
# API_KEYS_REQUIRED. Local wrangler dev provisions a local KV automatically
# once the binding is present.
# [[kv_namespaces]]
# binding = "API_KEYS"
# id = "REPLACE_WITH_KV_ID"

# [[kv_namespaces]]
# binding = "USAGE"
# id = "REPLACE_WITH_KV_ID"

# D1 database — created via `wrangler d1 create pynescript`.
# Schema (scripts + versions): axis setup d1 --local|--remote
#   (or wrangler d1 execute pynescript --remote --file=schemas/scripts.sql)
# Binding name MUST be "DB" (code uses env.DB) — not the database name.
[[d1_databases]]
binding = "DB"
database_name = "pynescript"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# R2 bucket — created via `wrangler r2 bucket create indicator-bundles`.
# [[r2_buckets]]
# binding = "BUNDLES"
# bucket_name = "indicator-bundles"

# Durable Objects — the WebSocket session relay.
# [[durable_objects.bindings]]
# name = "SESSIONS"
# class_name = "SessionDO"

# [[migrations]]
# tag = "v1"
# new_sqlite_classes = ["SessionDO"]

[vars]
# Default external backend if the Worker doesn't run the Python itself.
# When unset, /api/run returns 503 with a hint to set EXTERNAL_BACKEND or
# install the full Python wheel inside the Worker (see worker/RUNTIME.md).
EXTERNAL_BACKEND = ""
ALLOWED_ORIGIN = "https://pynescript.online"
ADMIN_TOKEN = ""
PYODIDE_IN_WORKER = "disabled"
# Local demos without KV: set to "1" to accept any Bearer key for /api/scripts
ALLOW_OPEN_KEYS = "1"
# Optional: OAuth App client ids for Connect with GitHub / GitLab (device flow).
# Create an OAuth App, enable Device Flow (GitHub), leave secret unused.
# Prefer: wrangler secret put GITHUB_OAUTH_CLIENT_ID
# GITHUB_OAUTH_CLIENT_ID = ""
# GITLAB_OAUTH_CLIENT_ID = ""

#!/bin/sh
# AXIS pre-commit gate: Biome (lint + format) on staged files only — fast.
# Skip with `git commit --no-verify` when you really mean it.
files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|json|jsonc|css|graphql)$')
if [ -z "$files" ]; then
  exit 0
fi

echo "Running biome check on staged files…"
# shellcheck disable=SC2086
printf '%s\0' $files | xargs -0 -r bunx biome check --no-errors-on-unmatched -- 2>&1
if [ $? -ne 0 ]; then
  echo "❌ Biome check failed on staged files. Fix them (bunx biome check --write <file>) or commit with --no-verify."
  exit 1
fi
echo "✓ Biome check passed."

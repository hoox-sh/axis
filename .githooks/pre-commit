#!/bin/sh
# AXIS pre-commit gate.
# 1. Biome on staged source files.
# 2. OKF enrich from the index, so the committed bundle matches the commit.
# Skip the OKF step with OKF_SKIP=1. Skip both with `git commit --no-verify`.

cd "$(git rev-parse --show-toplevel)" || exit 1

files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|json|jsonc|css|graphql)$' || true)
if [ -n "$files" ]; then
  echo "Running biome check on staged files…"
  # shellcheck disable=SC2086
  printf '%s\0' $files | xargs -0 -r bunx biome check --no-errors-on-unmatched -- 2>&1
  if [ $? -ne 0 ]; then
    echo "❌ Biome check failed on staged files. Fix them (bunx biome check --write <file>) or commit with --no-verify."
    exit 1
  fi
  echo "✓ Biome check passed."
fi

if [ "${OKF_SKIP:-}" = "1" ]; then
  exit 0
fi

echo "Refreshing OKF bundle…"
if ! bun scripts/okf/cli.ts enrich --from-index --stage; then
  echo "❌ OKF enrich failed. Fix the bundle or commit with OKF_SKIP=1 / --no-verify."
  exit 1
fi
echo "✓ OKF bundle is current."

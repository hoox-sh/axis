#
# Cloudflare Pages headers — mirror of docker/nginx.conf + server.ts baseline.
# Pages reads this from the publish directory (dist/) after `vite build`.
#
# The script-src nonce is a documented Cloudflare interop hook: when the zone's
# JavaScript Detections injects its bootstrap inline script, CF copies the nonce
# from our CSP header onto it so it passes. Keep until JSD is actually off.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'nonce-VwY65J9HsSZUqkEll3A' 'wasm-unsafe-eval' https://pyne-agent-worker.cryptolinx.workers.dev; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; worker-src 'self' blob:; child-src 'self' blob:; manifest-src 'self'

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AXIS main window — core, dialog, menu events, open scripts",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:app:default",
    "core:menu:default",
    "dialog:default",
    "allow-open-pine-scripts"
  ]
}

# Optional overrides for local / CI
# VITE_PYNE_API=http://127.0.0.1:5002

# Maintenance mode — boot only the maintenance page (dark screen, flickering
# HOOX mark, major-release teaser) instead of the app. Inlined at build time;
# set before `bun run dev` / `bun run build` to preview or ship it.
# VITE_MAINTENANCE_MODE=1

# Chart / engine debug logs (`[axis:chart]` / `[axis:engine]` in DevTools) plus
# a rotating localStorage ring (axis.debug.log.0…3, 64 KiB each). Download from
# System Logs or window.__AXIS_DEBUG__.download(). Inlined at build time —
# restart `bun run dev` after flipping. Alias: VITE_DEBUG.
# VITE_AXIS_DEBUG=1

# ── Docker Compose / Buildx ─────────────────────────────────────────
# AXIS_PORT=8081
# API_PORT=5002
# PROXY_PORT=8080
# BUN_VERSION=1.2.19
# GIT_SHA=dev
#
# Sister PYNE repo (for compose --profile api|proxy)
# Clone https://github.com/hoox-sh/pyne as ../pyne (dir is sometimes still named pynescript)
# PYNE_ROOT=../pyne
# PYNE_TARGET=api-dev
# PYNE_IMAGE=pynescript-api:axis
#
# Pre-built images (prod compose)
# AXIS_IMAGE=ghcr.io/hoox-sh/axis:pwa-latest
# AXIS_NGINX_IMAGE=ghcr.io/hoox-sh/axis:pwa-nginx-latest
# REGISTRY=ghcr.io/hoox-sh
# TAG=latest
#
# CORS for containerized API (browser origin of the PWA)
# ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8080

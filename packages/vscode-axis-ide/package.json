{
  "name": "axis-ide",
  "displayName": "AXIS IDE",
  "description": "AXIS chart IDE for VS Code — run Pine Script™ beside the editor with charts, results, and live sessions. Depends on PYNE Language Support (hoox-sh.pyne). Part of the HOOX open trading stack. Unofficial — not affiliated with TradingView, Inc.",
  "version": "0.1.0",
  "publisher": "hoox-sh",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "jango_blockchained",
    "url": "https://hoox.sh"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#050505",
    "theme": "dark"
  },
  "homepage": "https://hoox.sh/axis",
  "qna": "https://github.com/hoox-sh/axis/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoox-sh/axis.git",
    "directory": "packages/vscode-axis-ide"
  },
  "bugs": {
    "url": "https://github.com/hoox-sh/axis/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "hoox-sh.pyne"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "axis",
    "hoox",
    "pyne",
    "pinescript",
    "pine script",
    "charting",
    "trading",
    "indicators",
    "strategy"
  ],
  "activationEvents": [
    "onCustomEditor:axis.chart",
    "onCommand:axis.showRunOutput",
    "onCommand:axis.openChart",
    "onCommand:axis.secrets.setWorkerKey",
    "onCommand:axis.secrets.setProKey",
    "onCommand:axis.secrets.clear",
    "workspaceContains:**/*.axis.json",
    "workspaceContains:**/*.pyne",
    "workspaceContains:**/*.pine",
    "workspaceContains:**/*.pinev5",
    "workspaceContains:**/*.pinev6",
    "workspaceContains:**/*.pinescript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "axis.chart",
        "displayName": "AXIS Chart",
        "selector": [
          {
            "filenamePattern": "*.axis.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "axis.showRunOutput",
        "title": "Show Run Output",
        "category": "AXIS"
      },
      {
        "command": "axis.openChart",
        "title": "Open Chart",
        "category": "AXIS"
      },
      {
        "command": "axis.secrets.setWorkerKey",
        "title": "Set Worker API Key",
        "category": "AXIS"
      },
      {
        "command": "axis.secrets.setProKey",
        "title": "Set Pro API Key",
        "category": "AXIS"
      },
      {
        "command": "axis.secrets.clear",
        "title": "Clear Stored Secrets",
        "category": "AXIS"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "axis.openChart",
          "when": "resourceLangId == pinescript",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": [
      {
        "title": "AXIS IDE",
        "properties": {
          "axis.telemetry.offline": {
            "type": "boolean",
            "default": true,
            "description": "Keep product telemetry off by default in IDE."
          },
          "axis.chart.historyBars": {
            "type": "number",
            "default": 1500,
            "minimum": 50,
            "maximum": 20000,
            "markdownDescription": "Default OHLCV history window for new chart sessions and when the document omits a positive `historyBars`. Counts are clamped to **20000** (same as this maximum)."
          },
          "axis.chart.useMockBars": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "When true, chart sessions use deterministic mock/fixture bars (P1 default). When false, host still posts an empty `chart.full` to clear the series. Venue history lands with HistoryClient later."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile:webview": "vite build --config webview/chart/vite.config.ts",
    "compile": "node esbuild.host.mjs && npm run compile:webview",
    "check": "tsc -p ./ --noEmit && tsc -p webview/chart/tsconfig.json --noEmit",
    "watch": "node esbuild.host.mjs --watch",
    "watch:webview": "vite build --config webview/chart/vite.config.ts --watch",
    "watch:all": "npm run watch & npm run watch:webview",
    "compile-tests": "tsc -p tsconfig.tests.json",
    "package": "node -e \"const v=require('./package.json').version; require('child_process').execSync('npx --yes @vscode/vsce package --no-dependencies --no-git-tag-version --out axis-ide-'+v+'.vsix',{stdio:'inherit'})\"",
    "test:unit": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage",
    "test:coverage:gate": "bun run test:coverage && bun scripts/check-coverage.mjs",
    "test": "npm run compile-tests && npm run compile && node out/test/runTest.js"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.1",
    "mocha": "^11.1.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}

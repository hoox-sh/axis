{
  "activationEvents": [
    "onView:axis.alerts",
    "onCommand:axis.alerts.add",
    "onCommand:axis.alerts.remove"
  ],
  "contributes": {
    "views": {
      "axis": [
        { "id": "axis.alerts", "name": "Alerts" }
      ]
    },
    "commands": [
      {
        "command": "axis.alerts.add",
        "title": "Add Alert",
        "category": "AXIS"
      },
      {
        "command": "axis.alerts.remove",
        "title": "Remove Alert",
        "category": "AXIS"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "axis.alerts.add" },
        { "command": "axis.alerts.remove" }
      ],
      "view/title": [
        {
          "command": "axis.alerts.add",
          "when": "view == axis.alerts",
          "group": "navigation"
        },
        {
          "command": "axis.alerts.remove",
          "when": "view == axis.alerts",
          "group": "navigation"
        }
      ]
    }
  },
  "notes": {
    "merge": "Merge views into contributes.views.axis alongside library/layers/indicators/plugins/workers. Merge commands + activationEvents into package.json when wiring Task 19 into activate (extension.ts owns final contributes).",
    "workspaceState": {
      "key": "axis.alerts.v1",
      "shape": "AlertEntry[] — { id, title, condition?, enabled }",
      "mvp": "Add/remove via InputBox/QuickPick only — not full PWA alerts parity."
    }
  }
}

{
  "activationEvents": ["onView:axis.plugins.source", "onView:axis.plugins.stream"],
  "contributes": {
    "views": {
      "axis": [
        { "id": "axis.plugins.source", "name": "Sources" },
        { "id": "axis.plugins.stream", "name": "Streams" }
      ]
    },
    "menus": {
      "view/item/context": [
        { "command": "axis.plugins.activate", "when": "view == axis.plugins.source || view == axis.plugins.stream", "group": "inline" }
      ]
    }
  },
  "notes": {
    "merge": "Wiring agent merges views into contributes.views.axis (replace lumped axis.plugins with kind views + keep workers). Do not duplicate axis.plugins.activate command if plumbing already contributes it.",
    "owner": "source+stream feature agent"
  }
}

{
  "name": "@hoox-sh/axis-cli",
  "version": "0.2.2",
  "description": "AXIS CLI — install, doctor, worker setup, secrets, deploy, and health for the charting PWA",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "jango_blockchained",
  "bin": {
    "axis": "bin/axis.js",
    "axis-cli": "bin/axis.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "axis": "bun bin/axis.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "ansis": "^4.2.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoox-sh/axis.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/hoox-sh/axis/issues"
  },
  "homepage": "https://hoox.sh/axis",
  "keywords": [
    "axis",
    "hoox",
    "pyne",
    "cli",
    "cloudflare",
    "workers",
    "charting",
    "pwa",
    "pine-script",
    "deploy",
    "wrangler"
  ],
  "files": [
    "bin",
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ]
}
